{
  "manifest_version": 3,
  "name": "VoirAnime - DarkMod : streaming animes",
  "description": "Thème sombre et plus encore, pour l'ensemble du site \"voiranime.cx\" (VA).",
  "version": "2.2.2",
  "author": "Orilo",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "modal/popup.html",
    "default_title": "VoirAnime DarkMod"
  },
  "host_permissions": [
    "*://*.voiranime.cx/*",
    "*://myanimelist.net/*",
    "*://api.nijihub.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "versions/v200/*.css",
        "versions/v120/*.css"
      ],
      "matches": ["*://*.voiranime.cx/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.voiranime.cx/*"],
      "js": [
        "scripts/utils.js",
        "content.js",
        "scripts/remove-image-sizes.js",
        "scripts/auto-select.js",
        "scripts/vf-vostfr-switch.js",
        "scripts/characters.js",
        "scripts/scroll-to-watched.js",
        "scripts/fix-discord-icon.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; style-src 'self'; connect-src 'self' https://myanimelist.net https://api.nijihub.com;"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "voiranime-darkmod2@orilo",
      "strict_min_version": "109.0"
    }
  }
}
